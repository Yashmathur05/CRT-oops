# simple we are using rercursion here

class Solution:
    def inorderTraversal(self, root: Optional[TreeNode]) -> List[int]:

        ans = []

        def inorder(node):

            if node is None:
                return

            # Left
            inorder(node.left)

            # Root
            ans.append(node.val)

            # Right
            inorder(node.right)

        inorder(root)

        return ans
