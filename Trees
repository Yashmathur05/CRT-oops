##problem number 257 leetcode

# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right

class Solution:
    def binaryTreePaths(self, root: Optional[TreeNode]) -> List[str]:

        ans = []

        def dfs(node, path):

            if not node:
                return

            # Add current node to path
            path += str(node.val)

            # Leaf node
            if not node.left and not node.right:
                ans.append(path)
                return

            # Go left and right
            path += "->"

            dfs(node.left, path)
            dfs(node.right, path)

        dfs(root, "")

        return ans
