# Multiple Inheritance Example


# First Parent Class
class Human:
    def __init__(self, name):
        self.name = name


# Second Parent Class
class Person:
    def __init__(self, age):
        self.age = age


# Child Class inherits both Human and Person
class Student(Human, Person):

    def __init__(self, name, age):

        Human.__init__(self, name)
        Person.__init__(self, age)


# Object of Student class
s1 = Student("Yash", 21)

print("Name :", s1.name)
print("Age :", s1.age)

