#polymorphism
# Function Overloading Example


class Area:

    def area(self, length, breadth=0):

        # Square
        if breadth == 0:
            print("Area of Square :", length * length)

        # Rectangle
        else:
            print("Area of Rectangle :", length * breadth)


obj = Area()

obj.area(4)
obj.area(4, 6)
