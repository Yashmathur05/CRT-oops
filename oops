# Hierarchical Inheritance Example

# Parent Class
class Human:
    def __init__(self, name):
        self._name = name      # protected variable


# Child Class 1
class Student(Human):

    def show_student(self):
        print(self._name, "is a student")


# Child Class 2
class Teacher(Human):

    def show_teacher(self):
        print(self._name, "is a teacher")


# Object of Student class
s1 = Student("Yash")

# Object of Teacher class
t1 = Teacher("Rahul")


s1.show_student()
t1.show_teacher()

