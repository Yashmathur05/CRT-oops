#multilevel inheritance
# Parent Class
class Human:
    def __init__(self, name):
        self.name = name


# Child Class inherits Human
class Person(Human):
    def __init__(self, name, age):
        Human.__init__(self, name)
        self.age = age


# Child Class inherits Person
class Student(Person):
    pass


# Object of Student class
s1 = Student("Yash", 21)

print("Name :", s1.name)
print("Age :", s1.age)

