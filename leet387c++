#include <iostream>
#include <vector>
#include <string>
using namespace std;
// using freq array for the optimal approach, time complexity will be o(n)
int firstUniqChar(string s) {

    vector<int> freq(26, 0);

    // Count frequency
    for(char ch : s)
        freq[ch - 'a']++;

    // Find first unique character
    for(int i = 0; i < s.length(); i++) {

        if(freq[s[i] - 'a'] == 1)
            return i;
    }

    return -1;
}

int main() {

    string s = "loveleetcode";

    cout << firstUniqChar(s);

    return 0;
}
