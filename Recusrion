# sum of digits using recursions leetcode problem .
def sum_digits(n):

    # Base condition
    if n == 0:
        return 0

    # Last digit + recursive call
    return (n % 10) + sum_digits(n // 10)


# User input
n = int(input("Enter a number: "))

print("Sum of digits =", sum_digits(n))
