# print 2 table using recursion
def table(n, i):

    # Base condition
    if i == n+1:
        return

    print("2 x", i, "=", 2 * i)

    # Recursive call
    table(n, i + 1)


# User input
n = int(input("Enter value of n: "))

table(n, 1)
